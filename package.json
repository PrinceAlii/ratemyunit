{
  "name": "ratemyunit",
  "version": "0.0.1",
  "private": true,
  "description": "A platform for university students to rate their units/subjects",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run migrate -w @ratemyunit/db",
    "db:seed": "npm run seed -w @ratemyunit/db",
    "db:studio": "npm run studio -w @ratemyunit/db",
    "db:fix-uts-templates": "npm run fix-uts-templates -w @ratemyunit/db",
    "db:rebuild-usyd-template": "npm run rebuild-usyd-template -w @ratemyunit/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "0.27.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "lightningcss-linux-x64-gnu": "^1.29.2",
    "lightningcss-linux-x64-musl": "^1.29.2",
    "lightningcss-linux-arm64-gnu": "^1.29.2",
    "lightningcss-linux-arm64-musl": "^1.29.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "minimatch": "10.2.3",
    "rollup": "4.59.0",
    "fast-xml-parser": "5.3.8",
    "esbuild": "0.27.3",
    "drizzle-kit": {
      "esbuild": "0.27.3"
    },
    "@esbuild-kit/esm-loader": {
      "esbuild": "0.27.3"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.27.3"
    }
  }
}
